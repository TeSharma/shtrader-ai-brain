# Copy to `.env.local` and uncomment to override the engine the web console talks to.
# For local dev keep it unset (defaults to http://127.0.0.1:8000 via `npm run start:all`).
# For a deployed frontend (e.g. the Lovable preview), point it at your public engine:
# VITE_SHTRADER_API_URL=https://your-engine-host.example
